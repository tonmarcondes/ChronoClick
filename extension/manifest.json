{
  "manifest_version": 3,
  "name": "ChronoClick Recorder",
  "version": "0.11.0",
  "description": "Registra ações no navegador, prints da tela e microprints dos componentes DOM.",
  "icons": { "16": "icons/chronoclick-16.png", "32": "icons/chronoclick-32.png", "48": "icons/chronoclick-48.png", "128": "icons/chronoclick-128.png" },
  "key": "",
  "permissions": ["activeTab", "tabs", "storage", "nativeMessaging", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ChronoClick Recorder", "default_icon": { "16": "icons/chronoclick-16.png", "32": "icons/chronoclick-32.png", "48": "icons/chronoclick-48.png" } },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["recording-policy.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "review.html"
}
